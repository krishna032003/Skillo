# Skillo Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# Backend Connection
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional: Specialized Google Classroom Client ID
NEXT_PUBLIC_CLASSROOM_CLIENT_ID=your_google_classroom_oauth_client_id.apps.googleusercontent.com
